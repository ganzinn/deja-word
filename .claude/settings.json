{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh issue *)",
      "Bash(mise exec -- pnpm *)",
      "Bash(pnpm *)",
      "Bash(PORT=* pnpm *)",
      "Bash(BETTER_AUTH_URL=* pnpm *)",
      "Bash(E2E_BASE_URL=* pnpm *)",
      "Bash(SHOT_DIR=* pnpm *)",
      "Bash(node -e *)",
      "Bash(docker compose *)",
      "Bash(docker exec deja-word-db *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(awk *)",
      "Bash(echo *)",
      "Bash(curl *)",
      "Bash(lsof *)",
      "Bash(md5 *)",
      "Bash(pkill -f *next*)",
      "Bash(python3 *)",
      "Bash(openssl rand *)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:vercel.com)",
      "WebFetch(domain:neon.com)",
      "WebFetch(domain:www.better-auth.com)",
      "WebFetch(domain:registry.terraform.io)",
      "WebFetch(domain:docs.npmjs.com)",
      "WebFetch(domain:pnpm.io)",
      "mcp__Neon__list_docs_resources",
      "mcp__Neon__get_doc_resource"
    ],
    "ask": [
      "Bash(pnpm dotenv *)",
      "Bash(* pnpm dotenv *)",
      "Bash(dotenv -e *)",
      "Bash(* dotenv -e *)",
      "Bash(vercel env *)",
      "Bash(* vercel env *)",
      "Bash(* vercel promote*)",
      "Bash(* vercel rollback*)",
      "Bash(* vercel alias*)",
      "Bash(* vercel remove*)",
      "Bash(* vercel rm*)",
      "Bash(* vercel redeploy*)",
      "Bash(* vercel deploy*)",
      "Bash(* vercel --prod*)",
      "Bash(pnpm exec vercel)",
      "Bash(pnpm db:export-occurrence*)",
      "Bash(* pnpm db:export-occurrence*)",
      "Bash(pnpm db:reset-prod*)",
      "Bash(* pnpm db:reset-prod*)"
    ]
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p tmp && jq -c '{ts: (now | todate), tool_name, tool_input, permission_mode}' >> tmp/permission-requests.log"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-changed.sh\""
          }
        ]
      }
    ]
  }
}
