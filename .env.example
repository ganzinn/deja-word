# ローカル開発専用。Vercel 本番では以下が自動で供給される:
#   - DATABASE_URL / DATABASE_URL_UNPOOLED: Neon Marketplace Integration が注入
#   - BETTER_AUTH_SECRET: Vercel Dashboard で Production target に手動設定済み (Sensitive)
#   - BETTER_AUTH_URL: 未設定。auth.ts が VERCEL_PROJECT_PRODUCTION_URL から自動生成

DATABASE_URL="postgresql://dejaword:dejaword@localhost:5432/dejaword?schema=public"

# `openssl rand -base64 32` で生成した値をローカル .env.local に投入
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# スマホ実機など LAN 上の別端末から dev に接続して確認する場合のみ設定（要再起動）。
# IP は `ipconfig getifaddr en0` で確認。ワイルドカードは `192.168.*.*` 形式（`*` は1ラベル）。
# DEV_ALLOWED_ORIGINS="192.168.*.*"
# BETTER_AUTH_TRUSTED_ORIGINS="192.168.*.*"

# sign-up を停止したい環境にだけ "true" を設定 (Vercel では Production target に登録)。
# 未設定 / 任意の他値 → sign-up 有効。
# 停止中のユーザー追加は system ユーザーでログインして /admin/users から行う
# (メール登録 → 本人がパスワード設定。docs/ops/admin-user-invite.md 参照)。
# DISABLE_SIGNUP="true"

# system ユーザー (system@deja-word.internal) のパスワード。
# `pnpm db:set-system-password` 実行時に credential Account を upsert する。
# 8〜128 文字。production では Vercel に Sensitive で登録。
SYSTEM_USER_PASSWORD=""

# 単語音源 (Vercel Blob) の読み書きトークン。
# Vercel: Storage タブで Blob store を作成し Project に連携すると全環境へ自動注入される。
#
# ローカル開発では未設定でよい。未設定かつ NODE_ENV≠production のときは Vercel に
# 接続せず、ローカルディスク driver (.dev-blob/ + /api/dev-blob 配信) に自動で切り替わる
# (src/lib/blob-client.ts)。dev でも実 Blob を試したい場合のみ Dashboard の値を入れる。
# BLOB_READ_WRITE_TOKEN=""

# ローカルディスク driver の保存先 root（既定: <cwd>/.dev-blob）。通常は未設定でよい。
# git worktree で本体と DB を共有する場合のみ、本体の .dev-blob 絶対パスを指して
# 音源も共有する（scripts/wt-new.sh が自動で追記する）。例:
# DEV_BLOB_ROOT="/Users/you/rep/github.com/ganzinn/deja-word/.dev-blob"

# 単語フォームの「AI入力」(下書き生成) が使う Vercel AI Gateway の API キー。
# Vercel 上では OIDC で自動認証されるため設定不要。ローカルで使う場合のみ
# Vercel Dashboard → AI Gateway → API Keys で発行した値を .env.local に設定する。
# 未設定のときは AI入力ボタンが非表示になる（機能ごと無効化、他機能への影響なし）。
# AI_GATEWAY_API_KEY=""

# AI入力の生成モデルの上書き（既定: anthropic/claude-sonnet-5）。通常は未設定でよい。
# WORD_AI_MODEL="anthropic/claude-haiku-4.5"
