# Vitest 統合テスト用 (`pnpm test:integration`) の接続情報。
# 初回のみ次のコマンドで DB を作る:
#   docker exec -it deja-word-db psql -U dejaword -d postgres -c 'CREATE DATABASE dejaword_test;'
# このファイルを `.env.test` にコピーしてそのまま利用できる。
DATABASE_URL="postgresql://dejaword:dejaword@localhost:5432/dejaword_test?schema=public"
DIRECT_URL="postgresql://dejaword:dejaword@localhost:5432/dejaword_test?schema=public"
BETTER_AUTH_SECRET="test-secret-not-used-in-real-auth-flows-only-module-init"
BETTER_AUTH_URL="http://localhost:3000"
