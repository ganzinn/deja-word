# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.test.example

# local blob driver store (dev only)
/.dev-blob/

# local scratch (import CSV など、git 管理外)
/tmp/

# Claude Code のローカル許可リスト（共有ルールは追跡対象の .claude/settings.json 側が正本）
/.claude/settings.local.json

# devman logs
/log/

# prisma generated client
/src/generated/

# vercel
.vercel

# android (署名鍵・ビルド生成物は git 管理外)
/android/*.keystore
/android/.gradle/
/android/.kotlin/
/android/build/
/android/app/build/
/android/local.properties
/android/*.apk
/android/*.aab
/android/*.idsig

# typescript
*.tsbuildinfo
next-env.d.ts
