generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String                    @id
  name                     String
  email                    String
  emailVerified            Boolean                   @default(false)
  image                    String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  sessions                 Session[]
  accounts                 Account[]
  words                    Word[]
  meanings                 Meaning[]
  meaningTexts             MeaningText[]
  meaningNotes             MeaningNote[]
  examples                 Example[]
  exampleNotes             ExampleNote[]
  relatedWords             RelatedWord[]
  relatedWordNotes         RelatedWordNote[]
  memos                    Memo[]
  occurrences              Occurrence[]
  wordOccurrences          WordOccurrence[]
  occurrenceDetails        OccurrenceDetail[]
  occurrencePresetSettings OccurrencePresetSetting[]
  quizAnswers              QuizAnswer[]
  drills                   Drill[]
  quizDefaultSetting       QuizDefaultSetting?
  quizDefaultTimeouts      QuizDefaultTimeout[]
  preference               UserPreference?

  @@unique([email])
  @@map("user")
}

// ユーザー全般の設定: ユーザーごと 1 行。全項目任意（quiz 専用でない横断設定をここに集約する）
model UserPreference {
  userId      String   @id @map("user_id")
  // 発音音源が未登録のとき端末内蔵の自動音声（Web Speech API）で代用する。null = 有効（デフォルト）
  ttsFallback Boolean? @map("tts_fallback")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preference")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum ExampleKind {
  PHRASE
  SENTENCE
  TARGET
  MINIMAL
}

enum RelatedKind {
  SYNONYM
  ANTONYM
  DERIVATIVE
}

model Word {
  id        String   @id @default(cuid())
  ownerId   String   @map("owner_id")
  headword  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner                  User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  meanings               Meaning[]
  examples               Example[]
  relatedWords           RelatedWord[]    @relation("RelatedWordOnWord")
  linkedFromRelatedWords RelatedWord[]    @relation("RelatedWordLinkedWord")
  memos                  Memo[]
  wordOccurrences        WordOccurrence[]
  quizAnswers            QuizAnswer[]
  drillWords             DrillWord[]

  @@unique([ownerId, headword])
  @@index([ownerId])
  @@map("word")
}

model Meaning {
  id                    String  @id @default(cuid())
  wordId                String  @map("word_id")
  ownerId               String  @map("owner_id")
  partOfSpeech          String? @map("part_of_speech")
  pronunciation         String?
  sortOrder             Int     @default(0) @map("sort_order")
  pronunciationAudioUrl String? @map("pronunciation_audio_url") // 英単語の発音音源

  word  Word          @relation(fields: [wordId], references: [id], onDelete: Cascade)
  owner User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  texts MeaningText[]
  notes MeaningNote[]

  @@index([wordId])
  @@index([ownerId])
  @@map("meaning")
}

model MeaningText {
  id        String @id @default(cuid())
  meaningId String @map("meaning_id")
  ownerId   String @map("owner_id")
  text      String
  sortOrder Int    @default(0) @map("sort_order")

  meaning Meaning @relation(fields: [meaningId], references: [id], onDelete: Cascade)
  owner   User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([meaningId])
  @@index([ownerId])
  @@map("meaning_text")
}

model MeaningNote {
  id        String @id @default(cuid())
  meaningId String @map("meaning_id")
  ownerId   String @map("owner_id")
  text      String
  sortOrder Int    @default(0) @map("sort_order")

  meaning Meaning @relation(fields: [meaningId], references: [id], onDelete: Cascade)
  owner   User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([meaningId])
  @@index([ownerId])
  @@map("meaning_note")
}

model Example {
  id        String      @id @default(cuid())
  wordId    String      @map("word_id")
  ownerId   String      @map("owner_id")
  kind      ExampleKind
  text      String
  meaning   String?
  sortOrder Int         @default(0) @map("sort_order")

  word  Word          @relation(fields: [wordId], references: [id], onDelete: Cascade)
  owner User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  notes ExampleNote[]

  @@index([wordId])
  @@index([ownerId])
  @@map("example")
}

model ExampleNote {
  id        String @id @default(cuid())
  exampleId String @map("example_id")
  ownerId   String @map("owner_id")
  text      String
  sortOrder Int    @default(0) @map("sort_order")

  example Example @relation(fields: [exampleId], references: [id], onDelete: Cascade)
  owner   User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([exampleId])
  @@index([ownerId])
  @@map("example_note")
}

model RelatedWord {
  id            String       @id @default(cuid())
  wordId        String       @map("word_id")
  ownerId       String       @map("owner_id")
  kind          RelatedKind?
  term          String
  partOfSpeech  String?      @map("part_of_speech")
  pronunciation String?
  meaning       String?
  sortOrder     Int          @default(0) @map("sort_order")
  linkedWordId  String?      @map("linked_word_id")
  pronunciationAudioUrl String? @map("pronunciation_audio_url") // 関連語の発音音源

  word       Word              @relation("RelatedWordOnWord", fields: [wordId], references: [id], onDelete: Cascade)
  owner      User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  linkedWord Word?             @relation("RelatedWordLinkedWord", fields: [linkedWordId], references: [id], onDelete: SetNull)
  notes      RelatedWordNote[]

  @@index([wordId])
  @@index([ownerId])
  @@index([linkedWordId])
  @@map("related_word")
}

model RelatedWordNote {
  id            String @id @default(cuid())
  relatedWordId String @map("related_word_id")
  ownerId       String @map("owner_id")
  text          String
  sortOrder     Int    @default(0) @map("sort_order")

  relatedWord RelatedWord @relation(fields: [relatedWordId], references: [id], onDelete: Cascade)
  owner       User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([relatedWordId])
  @@index([ownerId])
  @@map("related_word_note")
}

model Memo {
  id        String @id @default(cuid())
  wordId    String @map("word_id")
  ownerId   String @map("owner_id")
  text      String
  sortOrder Int    @default(0) @map("sort_order")

  word  Word @relation(fields: [wordId], references: [id], onDelete: Cascade)
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([wordId])
  @@index([ownerId])
  @@map("memo")
}

model Occurrence {
  id            String  @id @default(cuid())
  ownerId       String  @map("owner_id")
  location      String
  sortOrder     Int      @default(0) @map("sort_order")
  autoNumbering Boolean  @default(false) @map("auto_numbering")
  createdAt     DateTime @default(now()) @map("created_at")

  owner               User                      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  wordLinks           WordOccurrence[]
  presetSettings      OccurrencePresetSetting[]
  drills              Drill[]
  quizDefaultSettings QuizDefaultSetting[]

  @@unique([ownerId, location])
  @@index([ownerId])
  @@map("occurrence")
}

model OccurrencePresetSetting {
  userId       String @map("user_id")
  occurrenceId String @map("occurrence_id")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurrence Occurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  @@id([userId, occurrenceId])
  @@index([userId])
  @@index([occurrenceId])
  @@map("occurrence_preset_setting")
}

model WordOccurrence {
  id               String @id @default(cuid())
  wordId           String @map("word_id")
  occurrenceId     String @map("occurrence_id")
  ownerId          String @map("owner_id")
  sortOrder        Int    @default(0) @map("sort_order")
  occurrenceNumber Int?   @map("occurrence_number")

  word       Word               @relation(fields: [wordId], references: [id], onDelete: Cascade)
  occurrence Occurrence         @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  owner      User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  details    OccurrenceDetail[]

  @@unique([wordId, occurrenceId])
  @@unique([occurrenceId, occurrenceNumber])
  @@index([wordId])
  @@index([occurrenceId])
  @@index([ownerId])
  @@map("word_occurrence")
}

model OccurrenceDetail {
  id               String @id @default(cuid())
  wordOccurrenceId String @map("word_occurrence_id")
  ownerId          String @map("owner_id")
  detail           String
  sortOrder        Int    @default(0) @map("sort_order")

  wordOccurrence WordOccurrence @relation(fields: [wordOccurrenceId], references: [id], onDelete: Cascade)
  owner          User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([wordOccurrenceId])
  @@index([ownerId])
  @@map("occurrence_detail")
}

enum QuizFormat {
  CHOICE // 形式1: 四択（英語→日本語）
  SELF_JUDGE // 形式2: 自己判定（英語→日本語）
  MULTI_MEANING // 形式3: 多義語選択（英語→日本語）
  CHOICE_JA_EN // 形式4: 四択（日本語→英語）
  SELF_JUDGE_JA_EN // 形式5: 自己判定（日本語→英語）
  SPELLING // 形式6: スペル確認（日本語→英語）
  CHOICE_TG // 形式7: 例文四択（英語→日本語）。TG 例文（Example.kind=TARGET）が素材
  CHOICE_TG_JA_EN // 形式8: 例文四択（日本語→英語）。TG 例文（Example.kind=TARGET）が素材
}

enum QuizResult {
  CORRECT
  INCORRECT
  VAGUE // うろ覚え（正解と不正解の中間）。自己判定の中間判定／四択等で正解後に降格して選ぶ。drill 残数は 2 の中間扱い（投入残数 2・リセット 2、drillIncludeCorrect 非依存で必ず投入）
  GAVE_UP // 四択・多義語選択の回答前「わからない」。drill の残数計算上は INCORRECT と同じ扱い（自己判定の「思い浮かばなかった」は VAGUE へ移行し廃止）
  TIMEOUT // 制限時間切れ。drill の残数計算上は INCORRECT と同じ扱い
}

enum QuizMode {
  TEST // 通常テスト
  DRILL // 定着モード
  DRILL_RETRY // 定着モードの「同じ問題で再テスト」。残数（DrillWord.remaining）に影響しない練習
}

// 解答履歴: 1解答=1行。通常テストも drill も同形で保存
model QuizAnswer {
  id        String     @id @default(cuid())
  ownerId   String     @map("owner_id")
  wordId    String     @map("word_id")
  mode      QuizMode
  format    QuizFormat
  result    QuizResult
  createdAt DateTime   @default(now()) @map("created_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  word  Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([ownerId, wordId])
  @@index([wordId])
  @@map("quiz_answer")
}

// テスト開始画面のデフォルト設定: ユーザーごと 1 行。全項目任意（部分的なデフォルトを許す）
model QuizDefaultSetting {
  userId         String      @id @map("user_id")
  occurrenceId   String?     @map("occurrence_id")
  rangeFrom      Int?        @map("range_from")
  rangeTo        Int?        @map("range_to")
  format         QuizFormat?
  showCountdown  Boolean?    @map("show_countdown") // 開始時カウントダウン演出の表示。null = 非表示（デフォルト）
  autoplayPronunciation Boolean? @map("autoplay_pronunciation") // 発音の自動再生。null = 有効（デフォルト）
  enableAnswerSound     Boolean? @map("enable_answer_sound")    // 正誤の効果音。null = 有効（デフォルト）
  autoplayAnswerAudioJaEn Boolean? @map("autoplay_answer_audio_ja_en") // 日→英の解答表示時の発音自動再生。null = 有効（デフォルト）
  choiceFirstMeaningTextOnly Boolean? @map("choice_first_meaning_text_only") // 四択（英→日）の選択肢で先頭の訳語のみ表示。null = ON（デフォルト＝先頭の訳語のみ）。false で全訳語を「; 」連結
  drillIncludeCorrect Boolean? @map("drill_include_correct") // 定着モードに正答単語も含める（テスト結果画面トグルの初期値）。null = OFF（デフォルト＝誤答のみ）。true で正答も出題
  // 定着までの回数（残数設定）の初期値。各 null = アプリ既定（誤答3 / うろ覚え2 / 正答1）。各 1..9
  resetRemaining          Int? @map("drill_reset_remaining")
  vagueRemaining          Int? @map("drill_vague_remaining")
  initialCorrectRemaining Int? @map("drill_initial_correct_remaining")
  saveOnStart    Boolean?    @map("save_on_start") // 開始画面「この設定をデフォルト設定とする」トグルの初期状態。null = OFF（デフォルト）
  updatedAt      DateTime    @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Occurrence 削除時は掲載箇所だけ未設定へ戻す（range / format のデフォルトは残す）
  occurrence Occurrence? @relation(fields: [occurrenceId], references: [id], onDelete: SetNull)

  @@index([occurrenceId])
  @@map("quiz_default_setting")
}

// 出題形式ごとのデフォルト制限時間: ユーザー × 形式で 1 行。行が無い形式 = 制限なし。
// 形式追加は QuizFormat の値追加だけで対応（カラム増設・マイグレーション不要）。
// 制限時間は occurrence に従属しないため occurrence リレーションは持たない（SetNull と独立）。
model QuizDefaultTimeout {
  userId         String     @map("user_id")
  format         QuizFormat
  timeoutSeconds Int        @map("timeout_seconds") // 1問あたりの制限時間（秒）。1..60
  updatedAt      DateTime   @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, format])
  @@index([userId])
  @@map("quiz_default_timeout")
}

// 定着待ちプール: 元テスト1回から生成、複数並存可
model Drill {
  id             String     @id @default(cuid())
  ownerId        String     @map("owner_id")
  occurrenceId   String     @map("occurrence_id")
  rangeFrom      Int        @map("range_from")
  rangeTo        Int        @map("range_to")
  // 元テストの範囲。null = 元テストが範囲指定なし（Occurrence 全体）。完了画面の
  // 「同じ範囲でもう一度テストする」に使う（既存行は実効範囲 range_from/to で backfill 済み）
  sourceRangeFrom Int? @map("source_range_from")
  sourceRangeTo   Int? @map("source_range_to")
  format         QuizFormat // 元テストの出題形式。全ラウンドで引き継ぐ
  timeoutSeconds Int?       @map("timeout_seconds") // 元テストの制限時間（秒）。全ラウンドで引き継ぐ。null = 制限なし
  choiceFirstMeaningTextOnly Boolean @default(false) @map("choice_first_meaning_text_only") // 元テストの「四択で先頭の訳語のみ表示」設定。全ラウンドで引き継ぐ
  // 定着までの残数設定。テスト開始時にユーザーが設定し全ラウンドで引き継ぐ（既存進行中 drill 向けに @default で backfill）
  resetRemaining          Int @default(3) @map("reset_remaining") // 誤答（GAVE_UP / TIMEOUT 含む）のリセット値
  vagueRemaining          Int @default(2) @map("vague_remaining") // うろ覚え（VAGUE）のリセット値
  initialCorrectRemaining Int @default(1) @map("initial_correct_remaining") // 正答単語の投入初期値
  roundCount     Int        @default(0) @map("round_count") // 完了したラウンド数。ラウンド送信の冪等化（CAS）に使う
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  completedAt    DateTime?  @map("completed_at") // 全単語定着時に設定。進行中一覧は completedAt IS NULL

  owner      User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  occurrence Occurrence  @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  words      DrillWord[]

  @@index([ownerId])
  @@index([occurrenceId])
  @@map("drill")
}

// drill 内の単語ごとの残数
model DrillWord {
  drillId   String   @map("drill_id")
  wordId    String   @map("word_id")
  remaining Int // 定着までの残連続正解数 (0..max)。初期値・リセット値は Drill の残数設定（reset/vague/initialCorrect, 各 1..9）由来
  updatedAt DateTime @updatedAt @map("updated_at")

  drill Drill @relation(fields: [drillId], references: [id], onDelete: Cascade)
  word  Word  @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@id([drillId, wordId])
  @@index([wordId])
  @@map("drill_word")
}
