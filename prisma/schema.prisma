generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id
  name              String
  email             String
  emailVerified     Boolean            @default(false)
  image             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  sessions          Session[]
  accounts          Account[]
  words             Word[]
  meanings          Meaning[]
  meaningTexts      MeaningText[]
  examples          Example[]
  relatedWords      RelatedWord[]
  memos             Memo[]
  occurrences              Occurrence[]
  wordOccurrences          WordOccurrence[]
  occurrenceDetails        OccurrenceDetail[]
  occurrencePresetSettings OccurrencePresetSetting[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum ExampleKind {
  PHRASE
  SENTENCE
  TARGET
  MINIMAL
}

enum RelatedKind {
  SYNONYM
  ANTONYM
  DERIVATIVE
}

model Word {
  id        String   @id @default(cuid())
  ownerId   String   @map("owner_id")
  headword  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner                  User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  meanings               Meaning[]
  examples               Example[]
  relatedWords           RelatedWord[]    @relation("RelatedWordOnWord")
  linkedFromRelatedWords RelatedWord[]    @relation("RelatedWordLinkedWord")
  memos                  Memo[]
  wordOccurrences        WordOccurrence[]

  @@unique([ownerId, headword])
  @@index([ownerId])
  @@map("word")
}

model Meaning {
  id            String  @id @default(cuid())
  wordId        String  @map("word_id")
  ownerId       String  @map("owner_id")
  partOfSpeech  String? @map("part_of_speech")
  pronunciation String?
  note          String?
  sortOrder     Int     @default(0) @map("sort_order")

  word  Word          @relation(fields: [wordId], references: [id], onDelete: Cascade)
  owner User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  texts MeaningText[]

  @@index([wordId])
  @@index([ownerId])
  @@map("meaning")
}

model MeaningText {
  id        String @id @default(cuid())
  meaningId String @map("meaning_id")
  ownerId   String @map("owner_id")
  text      String
  sortOrder Int    @default(0) @map("sort_order")

  meaning Meaning @relation(fields: [meaningId], references: [id], onDelete: Cascade)
  owner   User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([meaningId])
  @@index([ownerId])
  @@map("meaning_text")
}

model Example {
  id        String      @id @default(cuid())
  wordId    String      @map("word_id")
  ownerId   String      @map("owner_id")
  kind      ExampleKind
  text      String
  meaning   String?
  note      String?
  sortOrder Int         @default(0) @map("sort_order")

  word  Word @relation(fields: [wordId], references: [id], onDelete: Cascade)
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([wordId])
  @@index([ownerId])
  @@map("example")
}

model RelatedWord {
  id            String       @id @default(cuid())
  wordId        String       @map("word_id")
  ownerId       String       @map("owner_id")
  kind          RelatedKind?
  term          String
  partOfSpeech  String?      @map("part_of_speech")
  pronunciation String?
  meaning       String?
  note          String?
  sortOrder     Int          @default(0) @map("sort_order")
  linkedWordId  String?      @map("linked_word_id")

  word       Word  @relation("RelatedWordOnWord", fields: [wordId], references: [id], onDelete: Cascade)
  owner      User  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  linkedWord Word? @relation("RelatedWordLinkedWord", fields: [linkedWordId], references: [id], onDelete: SetNull)

  @@index([wordId])
  @@index([ownerId])
  @@index([linkedWordId])
  @@map("related_word")
}

model Memo {
  id        String @id @default(cuid())
  wordId    String @map("word_id")
  ownerId   String @map("owner_id")
  text      String
  sortOrder Int    @default(0) @map("sort_order")

  word  Word @relation(fields: [wordId], references: [id], onDelete: Cascade)
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([wordId])
  @@index([ownerId])
  @@map("memo")
}

model Occurrence {
  id        String @id @default(cuid())
  ownerId   String @map("owner_id")
  location  String
  sortOrder Int    @default(0) @map("sort_order")

  owner          User                      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  wordLinks      WordOccurrence[]
  presetSettings OccurrencePresetSetting[]

  @@unique([ownerId, location])
  @@index([ownerId])
  @@map("occurrence")
}

model OccurrencePresetSetting {
  userId       String @map("user_id")
  occurrenceId String @map("occurrence_id")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurrence Occurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  @@id([userId, occurrenceId])
  @@index([userId])
  @@index([occurrenceId])
  @@map("occurrence_preset_setting")
}

model WordOccurrence {
  id               String @id @default(cuid())
  wordId           String @map("word_id")
  occurrenceId     String @map("occurrence_id")
  ownerId          String @map("owner_id")
  sortOrder        Int    @default(0) @map("sort_order")
  occurrenceNumber Int?   @map("occurrence_number")

  word       Word               @relation(fields: [wordId], references: [id], onDelete: Cascade)
  occurrence Occurrence         @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  owner      User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  details    OccurrenceDetail[]

  @@unique([wordId, occurrenceId])
  @@unique([occurrenceId, occurrenceNumber])
  @@index([wordId])
  @@index([occurrenceId])
  @@index([ownerId])
  @@map("word_occurrence")
}

model OccurrenceDetail {
  id               String @id @default(cuid())
  wordOccurrenceId String @map("word_occurrence_id")
  ownerId          String @map("owner_id")
  detail           String
  sortOrder        Int    @default(0) @map("sort_order")

  wordOccurrence WordOccurrence @relation(fields: [wordOccurrenceId], references: [id], onDelete: Cascade)
  owner          User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([wordOccurrenceId])
  @@index([ownerId])
  @@map("occurrence_detail")
}
